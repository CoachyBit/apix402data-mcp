[
  {
    "name": "web_search",
    "title": "Live web search JSON",
    "description": "[$0.002] Fast live web and news search JSON (up to 5 batched queries) with relevance score, sentiment, and entities. $0.002/call \u2014 2.5x to 5x cheaper than $0.005-$0.01 search APIs. Do not use for single-URL extraction (use web_fetch_markdown) or crypto ticker feeds (use news_crypto_feed). `q` and `query` are aliases, `queries` overrides them for up to 5 batched lookups (1 HTTP request), and omitting all returns top headlines. Live web/RSS data, read-only; requires x402 USDC or Stripe MPP (10 free lifetime calls via /api/free/*) at 60 HTTP req/min.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200,
          "description": "Search query (alias: q)"
        },
        "q": {
          "type": "string",
          "maxLength": 200,
          "description": "Search query \u2014 supports AI, crypto, finance, tech, biotech, energy topics"
        },
        "category": {
          "type": "string",
          "enum": [
            "web",
            "news"
          ],
          "maxLength": 50,
          "description": "Filter by category: web or news"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50,
          "description": "Max results to return per query (default 50, max 500)"
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "description": "Batch: array of up to 5 queries; priced unit price x count"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Return only these result keys, e.g. [\"title\",\"url\",\"enrichment.sentiment\"]"
        },
        "session_token": {
          "type": "string",
          "description": "Optional prepaid session token (x402s_...) from https://apix402data.com/pay after the 10-call free preview."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "Live web search JSON",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_source": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "query": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "snippet": {
                "type": "string"
              },
              "enrichment": {
                "type": "object",
                "properties": {
                  "headline": {
                    "type": "string"
                  },
                  "relevance_score": {
                    "type": "integer"
                  },
                  "key_takeaway": {
                    "type": "string"
                  },
                  "sentiment": {
                    "type": "string"
                  },
                  "entities": {
                    "type": "array",
                    "items": {}
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "related_queries": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "wikipedia": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "extract": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      }
                    }
