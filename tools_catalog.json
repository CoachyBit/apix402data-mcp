  {
    "name": "web_fetch_markdown",
    "title": "Webpage to clean LLM Markdown",
    "description": "[$0.002] Fetch any public HTTPS webpage (SSRF-guarded), strip ads/nav boilerplate, and return clean LLM-ready Markdown, word count, summary, and extracted entities ($0.002/call). Do not use for searching across sites (use web_search) or probing x402 paywalls (use x402_paywall_probe). Only `summarize=true` invokes the local LLM, and expiring `timeout_ms` returns `degraded=true` with extracted Markdown but no summary. Live SSRF-guarded HTTPS fetch, read-only; requires x402 USDC or Stripe MPP (10 free lifetime calls via /api/free/*) at 30-60 req/min.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2000,
          "description": "Any public URL to fetch, clean, and extract content from"
        },
        "summarize": {
          "type": "boolean",
          "default": false,
          "description": "Add LLM-powered summary with entity extraction and sentiment scoring"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000,
          "description": "Optional deadline in ms. If the local LLM would exceed it, the response comes back fast with \"degraded\": true and non-LLM/cached data"
        },
        "session_token": {
          "type": "string",
          "description": "Optional prepaid session token (x402s_...) from https://apix402data.com/pay after the 10-call free preview."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "Webpage to clean LLM Markdown",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "word_count": {
          "type": "integer"
        },
        "robots_txt_allowed": {
          "type": "boolean"
        },
        "cached": {
          "type": "boolean"
        },
        "cache_age_seconds": {
          "type": "number"
        },
        "sentiment": {
          "type": "string"
        },
        "sentiment_score": {
          "type": "number"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nlp_method": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        }
      }
    }
  },
